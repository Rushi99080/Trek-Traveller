# ============================================================
#  ENVIRONMENT VARIABLES (secret keys)
#  Copy this file to ".env.local" for your computer, and add the
#  same names + values in Vercel → Project → Settings → Environment Variables.
#  Everything is optional: without keys the site runs in demo mode.
# ============================================================

# Your live website address (no slash at the end)
NEXT_PUBLIC_SITE_URL=https://www.yourcompany.com

# ---------- Admin panel ----------
# Password for /admin (use something long)
ADMIN_PASSWORD=

# ---------- Supabase (database) ----------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Razorpay (payments) ----------
# Razorpay Dashboard → Account & Settings → API Keys
# Use test keys (rzp_test_...) first, then live keys (rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks (URL: https://YOURSITE/api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (booking confirmations + team alerts) ----------
# Free account at resend.com
RESEND_API_KEY=
EMAIL_FROM=Your Company <bookings@yourcompany.com>
# Where new booking and enquiry alerts are sent
TEAM_EMAIL=

# ---------- Analytics ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- WhatsApp Business API (later, optional) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOOKING_TEMPLATE=booking_confirmation
